{
  "rewrites": [
    {
      "source": "/webapp",
      "destination": "https://fairwater-app.web.app/"
    },
    {
      "source": "/webapp/",
      "destination": "https://fairwater-app.web.app/"
    },
    {
      "source": "/webapp/:path*",
      "destination": "https://fairwater-app.web.app/:path*"
    }
  ]
}
